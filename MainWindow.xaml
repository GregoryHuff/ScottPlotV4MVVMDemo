<Window x:Class="ScottPlotV5MVVMDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScottPlotV5MVVMDemo"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="800">
    <Window.DataContext>
        <local:YourViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <ScottPlot:WpfPlot Name="NonMVVMPlot" Grid.Column="0"/>

        <ScottPlot:WpfPlot Name="MVVMPlot" Grid.Column="2"
                           local:ScottPlotMVVMExtension.ItemsSource="{Binding Values}"
                           local:ScottPlotMVVMExtension.FrameRate="1000"
                           local:ScottPlotMVVMExtension.Title ="MVVM Plot 1"
                           />
        <ScottPlot:WpfPlot Name="MVVMPlot2" Grid.Column="4"
                   local:ScottPlotMVVMExtension.ItemsSource="{Binding MoreValues}"
                   local:ScottPlotMVVMExtension.FrameRate="1000"
                   local:ScottPlotMVVMExtension.Title ="Another MVVM Plot"
                   />
        
    </Grid>
</Window>